# mock (default) | email | http
BOARDY_BACKEND=mock

# stdio (default) | http | api
# BOARDY_TRANSPORT=stdio

# Streamable HTTP MCP bind. Localhost only.
# PORT=3000
# BOARDY_HTTP_HOST=127.0.0.1

# Reference implementation of spec/openapi.yaml. Fake token is the literal "fixture".
# BOARDY_API_PORT=8787
# BOARDY_API_TOKEN=fixture

# Identity used when drafting email to boardy@boardy.ai.
# The email backend does not read a profile from Boardy.
# BOARDY_ASSISTANT_NAME=Boardy MCP
# BOARDY_USER_NAME=
# BOARDY_USER_EMAIL=
# BOARDY_USER_ROLE=
# BOARDY_USER_COMPANY=
# BOARDY_USER_LOCATION=
# BOARDY_USER_LINKEDIN=
# BOARDY_USER_X=
# BOARDY_USER_GITHUB=
# BOARDY_USER_WEBSITE=

# Optional. Mail is sent only when a tool call sets send=true and
# userApprovedExactText=true with the exact drafted body.
# BOARDY_SMTP_HOST=
# BOARDY_SMTP_PORT=587
# BOARDY_SMTP_USER=
# BOARDY_SMTP_PASS=
# BOARDY_SMTP_FROM=

# Proposed API client. These hosts are not a published Boardy service.
# BOARDY_API_BASE_URL=http://127.0.0.1:8787
# BOARDY_API_KEY=
# BOARDY_API_TOKEN=

# Remote OAuth resource server. off (default) or oauth.
# This process does not issue tokens. BOARDY_OAUTH_ISSUER is your authorization server.
# BOARDY_AUTH=oauth
# BOARDY_PUBLIC_URL=http://127.0.0.1:3000/mcp
# BOARDY_OAUTH_ISSUER=https://auth.example.com
# RFC 7662 token introspection. Preferred over the dev bearer.
# BOARDY_INTROSPECTION_URL=https://auth.example.com/oauth/introspect
# BOARDY_INTROSPECTION_AUTHORIZATION=
# Localhost-only shared secret. Not an OAuth token. Refused for other Host headers
# unless BOARDY_ALLOW_DEV_BEARER=1.
# BOARDY_DEV_BEARER=
# BOARDY_ALLOW_DEV_BEARER=
# Optional browser Origin hostnames, comma-separated. Empty keeps the localhost check
# when the public URL is local, and skips Origin filtering when it is public.
# BOARDY_ALLOWED_ORIGINS=
